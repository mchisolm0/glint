         "a part of a part"
     );
 }
+
+/// An `image` of a GIF (and of a JPEG or WebP, which share its path) draws
+/// on every painted host. Linux has no decoder behind `jpeg_decode::decode`
+/// (`#[cfg(not(any(android, windows, macos)))]` refuses every one), so this
+/// passes on macOS and Windows and fails on Linux.
+#[test]
+fn a_gif_decodes_on_every_painted_host() {
+    for path in [
+        "apps/motion-gallery/assets/spin.gif",
+        "apps/shared-elements/assets/alpine-water.jpg",
+    ] {
+        let root = std::path::Path::new(env!("CARGO_MANIFEST_DIR")).join("../..");
+        let bytes = std::fs::read(root.join(path)).unwrap();
+        let header = inspect(&mut Cursor::new(&bytes), bytes.len() as u64).unwrap();
+        let natural = header.metadata.natural;
+        let plan = DecodePlan::new(header, (natural.width, natural.height)).unwrap();
+        let decoded = decode_rows(Cursor::new(&bytes), &plan, || false);
+        assert!(decoded.is_ok(), "{path}: {decoded:?}");
+    }
+}
