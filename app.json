{
  "$schema": "../exact/scripts/app.schema.json",
  "name": "Glint",
  "short_name": "Glint",
  "id": "dev.mchisolm0.glint",
  "start_url": "/",
  "display": "standalone",
  "icons": [
    {
      "src": "assets/icon.png",
      "sizes": "1024x1024",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "app": {
    "id": "dev.mchisolm0.glint",
    "name": "Glint"
  },
  "host": {
    "web": {},
    "macos": {
      "icon": "art/Glint.icon",
      "minimumOS": "15.0",
      "window": {
        "width": 900,
        "height": 700
      }
    },
    "linux": {
      "window": {
        "keepRunning": true
      }
    }
  },
  "deploy": {
    "store": {
      "web": "0",
      "macos": "0",
      "linux": "0"
    }
  },
  "rust": {
    "placement": "worker",
    "data": {
      "crate": "glint-data",
      "type": "glint_data::Glint"
    }
  },
  "userInterfaceStyle": "dark"
}
