// Glint: screenshots, recordings and annotations from global shortcuts or the menu bar item.
// data/src/lib.rs takes pictures and recordings (glint-capture: ScreenCaptureKit on the Mac, the desktop portal on Linux);
// app.ts keeps, lists, copies and saves them, and draws the editor's canvas;
// modules/apple/*.swift draws the Mac's overlays and floating panels (docs/design.md).
use globalShortcut, globalshortcut, GlobalShortcut from "@exact/global-shortcuts"
use detectText, DetectedTextList from "@exact/text-detection"
use loginItemStatus, registerLoginItem, unregisterLoginItem, LoginItemStatus from "@exact/login-item"
use Capture, Mark, Edit, Reply from "./shapes.contract"

// A picture or recording Rust just finished, waiting in the staging folder for app.ts to keep it.
// `mosaic` is a 1/16-size copy the editor's pixelate tool scales up ("" for video).
shape Staged
  path: string
  taken: number
  width: number
  height: number
  kind: string
  duration: number
  mosaic: string

// What `startRecording` answers: the recording runs until `stopRecording`.
shape Recording
  recording: bool
  started: number
  kind: string

// A rectangle in the desktop's global points, origin top-left. `picked` is false when Escape cancelled;
// `window` is the CGWindowID of a picked window, else 0.
shape Area
  picked: bool
  x: number
  y: number
  width: number
  height: number
  window: number

// The latest thing a floating panel asked the app to do (`annotate`, `stopRecording`); seq 0 is none yet.
shape Request
  seq: number
  kind: string
  path: string

// Where the app runs (Rust's std::env::consts::OS): "macos" has the floating panels and the menu bar item.
shape Platform
  os: string

// The native path of the folder Linux captures go to; "" until the person chooses one.
shape SaveDir
  native: string

shape Viewport
  width: number
  height: number
  devicePixelRatio: option<number>

fn keysLine(a: GlobalShortcut, b: GlobalShortcut, c: GlobalShortcut, d: GlobalShortcut, e: GlobalShortcut, f: GlobalShortcut, linux: bool): string = a.registered and b.registered and c.registered and d.registered and e.registered and f.registered ? (linux ? "Shift+Ctrl+Alt+Super 3 screen · 4 area · 2 window · 5 record · 1 scroll" : "Hyper 3 screen · 4 area · 2 window · 5 record · 1 scroll · T text") : linux ? "A shortcut is not set; set them in Settings, Apps, Glint." : "A shortcut is taken by another app; use the menu bar item."
fn clock(ms: number): string = `${floor(ms / 60000)}:${floor(ms / 1000) % 60 < 10 ? "0" : ""}${floor(ms / 1000) % 60}`
fn sizeLine(c: Capture): string = c.kind == "png" ? `${c.width}×${c.height}` : `${c.kind.toUpperCase()} ${clock(c.duration)} · ${c.width}×${c.height}`
// A failure worth showing: a picker the person cancelled is not one.
fn shown(prefix: string, message: string): string = message.endsWith("was cancelled") ? "" : `${prefix}: ${message}`
fn strokeOf(level: number, unit: number): number = (level == 1 ? 3 : level == 2 ? 6 : 12) * unit
// A tool's tooltip: its name and the key that picks it (editKey).
fn toolTip(t: string): string = t == "arrow" ? "Arrow (A)" : t == "rect" ? "Rectangle (R)" : t == "ellipse" ? "Ellipse (O)" : t == "line" ? "Line (L)" : t == "pen" ? "Pen (P)" : t == "marker" ? "Highlighter (H)" : t == "text" ? "Text (T)" : t == "pixelate" ? "Pixelate (B)" : t == "step" ? "Numbered step (N)" : t == "spotlight" ? "Spotlight (S)" : "Crop (C)"

component Glint
  resource captures = captures() as shape Capture[] else empty()
  resource screenKey = globalShortcut(id="screen", keys="Control+Alt+Shift+Meta+3") as shape GlobalShortcut else empty(id="screen", keys="Control+Alt+Shift+Meta+3", registered=false)
  resource areaKey = globalShortcut(id="area", keys="Control+Alt+Shift+Meta+4") as shape GlobalShortcut else empty(id="area", keys="Control+Alt+Shift+Meta+4", registered=false)
  resource recordKey = globalShortcut(id="record", keys="Control+Alt+Shift+Meta+5") as shape GlobalShortcut else empty(id="record", keys="Control+Alt+Shift+Meta+5", registered=false)
  resource textKey = globalShortcut(id="text", keys="Control+Alt+Shift+Meta+T") as shape GlobalShortcut else empty(id="text", keys="Control+Alt+Shift+Meta+T", registered=false)
  resource scrollKey = globalShortcut(id="scroll", keys="Control+Alt+Shift+Meta+1") as shape GlobalShortcut else empty(id="scroll", keys="Control+Alt+Shift+Meta+1", registered=false)
  resource windowKey = globalShortcut(id="window", keys="Control+Alt+Shift+Meta+2") as shape GlobalShortcut else empty(id="window", keys="Control+Alt+Shift+Meta+2", registered=false)
  resource request = requests() as shape Request else empty(seq=0, kind="", path="")
  resource viewport = exactViewport() as shape Viewport
  resource platform = platform() as shape Platform else empty(os="")
  resource login = loginItemStatus() as shape LoginItemStatus else empty(available=false, state="unknown", hidden=false, launchedAtLogin=false)
  mutation area as shape Area then afterArea
  mutation staged as shape Staged then afterStaged
  mutation shot as shape Capture refreshes captures then afterShot
  mutation recording as shape Recording then afterRecording
  mutation read as shape DetectedTextList then afterRead
  mutation opened as shape Edit then afterOpened
  mutation saved as shape Capture refreshes captures then afterSaved
  mutation shown as shape Reply
  mutation hud as shape Reply
  mutation copied as shape Reply
  mutation acted as shape Reply
  mutation removed as shape Reply refreshes captures
  mutation loginSet as shape LoginItemStatus refreshes login
  mutation folderSet as shape SaveDir then afterFolder

  // Settings, kept across launches.
  state copyAfter = true persist
  state quickAfter = true persist
  state recFormat = "mp4" persist
  state recCursor = true persist
  state recClicks = true persist
  state recAudio = false persist
  state recMic = false persist
  // On Linux, the `doc:` folder captures go to (kept across launches by `doc.keep`) and its native path.
  state saveFolder = "" persist
  state saveTo = "" persist

  // The library and what a capture is for.
  state selected = ""
  state note = ""
  state picking = ""
  state recordingOn = false
  state recX = 0
  state recY = 0
  state recW = 0
  state recH = 0
  derive onMac = platform.os == "macos"
  // Linux's host shows PNGs only (no video player or GIF decoder) and copies PNGs and text only.
  derive onLinux = platform.os == "linux"
  // A Linux capture waits for the person to choose a folder; `resume` is the one waiting.
  derive needsFolder = onLinux and saveTo == ""
  state resume = ""
  derive current = first(captures.filter(c => c.path == selected))
  // A recording or a scrolling capture (picking == "scroll") is running.
  derive scrolling = recordingOn and picking == "scroll"
  derive busy = pending(staged) or pending(shot) or pending(area) or pending(recording)
  derive problem = match failure(staged) { case some(f) => shown("Capture failed", f.message), case none => match failure(shot) { case some(f) => `Saving failed: ${f.message}`, case none => match failure(recording) { case some(f) => shown("Recording failed", f.message), case none => match failure(saved) { case some(f) => `Saving the edit failed: ${f.message}`, case none => match failure(read) { case some(f) => `Text recognition failed: ${f.message}`, case none => "" } } } } }

  // The editor, open on the selected screenshot. Marks and the crop are in the image's pixels. `dirty`: marks
  // not saved yet, which a switch to another capture saves first (`nextPath`), as Copy does (`copyNext`).
  state editing = ""
  state dirty = false
  state nextPath = ""
  state nextKind = ""
  state copyNext = false
  state tool = "arrow"
  state color = "#ff3b30"
  state level = 2
  state marks = []
  state undone = []
  state drawing = false
  state sx = 0
  state sy = 0
  state ex = 0
  state ey = 0
  state pts = ""
  state background = false
  state cx = 0
  state cy = 0
  state cw = 0
  state ch = 0
  state textOn = false
  state tx = 0
  state ty = 0
  state textLeft = 0
  state textTop = 0
  state textValue = ""
  state exporting = false
  derive editCap = first(captures.filter(c => c.path == editing))
  derive iw = match editCap { case some(c) => c.width, case none => 1 }
  derive ih = match editCap { case some(c) => c.height, case none => 1 }
  derive mosaic = match editCap { case some(c) => c.mosaic, case none => "" }
  derive vx = cw > 0 ? cx : 0
  derive vy = cw > 0 ? cy : 0
  derive vw = cw > 0 ? cw : iw
  derive vh = cw > 0 ? ch : ih
  derive pad = background ? round(max(vw, vh) * 0.07) : 0
  derive bw = vw + 2 * pad
  derive bh = vh + 2 * pad
  // The window less the library list, the bars above the canvas and the stage's padding.
  derive availW = max(200, viewport.width - 231 - 32)
  derive availH = max(150, viewport.height - 160)
  derive cssW = min(availW, availH * bw / bh)
  derive cssH = cssW * bh / bw
  derive k = bw / cssW
  derive dpr = match viewport.devicePixelRatio { case some(r) => max(1, r), case none => 2 }
  derive unit = max(1, round(max(iw, ih) / 1500))
  derive stroke = strokeOf(level, unit)
  derive steps = marks.filter(m => m.kind == "step").length
  derive typed = Mark(kind="text", color=color, size=stroke, x1=tx, y1=ty, x2=tx, y2=ty, points="", text=textValue, n=0)
  derive withText = textOn and textValue.trim() != "" ? marks.concat([typed]) : marks
  derive draft = Mark(kind=tool, color=color, size=stroke, x1=sx, y1=sy, x2=ex, y2=ey, points=pts, text="", n=0)

  // Taking pictures.
  action screen
    take("screen")
  action pickArea
    take("area")
  action pickWindow
    take("window")
  // The window that has focus, with no overlay. Linux has no way to name it, so the desktop's picker asks.
  action frontWindow
    take("front")
  action pickText
    if onLinux
      note = "No text recognition on Linux yet."
    else
      if not busy
        picking = "text"
        send area = pick("area")
  action record
    if recordingOn
      stop()
    else
      take("record")
  // Scrolling capture: pick an area, scroll it, then Done (or the shortcut again) stitches one tall PNG.
  action scrollCapture
    if recordingOn
      stop()
    else
      take("scroll")
  // A capture by its kind: "screen", or what `pick` asks for ("front" is the focused window, "scroll" an area).
  // On Linux it waits for a folder first.
  action take(id: string)
    if needsFolder
      askFolder(id)
    else
      capture(id, saveTo)
  // `dir` is where Rust writes the capture (data/src/lib.rs `staged`).
  action capture(id: string, dir: string)
    if not busy
      picking = id == "front" ? "window" : id
      if id == "screen"
        send staged = captureScreen(dir)
      else
        send area = pick(id == "scroll" ? "area" : id)
  // Where captures go: the desktop's folder picker, opening at the pictures folder's Screenshots.
  action askFolder(id: string)
    resume = id
    note = "Choose a folder for your captures."
    chooseFolder()
  action chooseFolder
    showDirectoryPicker("save-folder", startIn=(saveFolder != "" ? saveFolder : "screenshots"))
  action chose(value: string)
    saveFolder = value
    send folderSet = saveDir(value)
  action afterFolder
    match folderSet
      case some(d)
        saveTo = d.native
        note = ""
      case none
        note = ""
  // The capture that asked for a folder goes on once there is one, after the picker has left the screen.
  task resumeCapture when resume != "" and saveTo != "" key=saveTo
    after(600, onResume)
  action onResume
    capture(resume, saveTo)
    resume = ""
  action stop
    recordingOn = false
    send hud = hideHud()
    send staged = stopRecording()
  action afterArea
    match area
      case some(a)
        if a.picked
          if picking == "record" or picking == "scroll"
            let still = picking == "scroll"
            recX = a.x
            recY = a.y
            recW = a.width
            recH = a.height
            send recording = startRecording(a.x, a.y, a.width, a.height, still ? "scroll" : recFormat, recCursor and not still, recClicks and not still, recAudio and not still, recMic and not still, saveTo)
          else
            if a.window != 0
              send staged = captureWindow(a.window, saveTo)
            else
              send staged = captureArea(a.x, a.y, a.width, a.height, saveTo)
      case none
        note = ""
  action afterRecording
    match recording
      case some(r)
        recordingOn = r.recording
        send hud = showHud(recX, recY, recW, recH, picking)
      case none
        recordingOn = false
  action afterStaged
    match staged
      case some(s)
        if picking == "text"
          send read = detectText(image=s.path)
        else
          send shot = keepCapture(s.path, s.taken, s.width, s.height, s.kind, s.duration, s.mosaic, saveTo == "" ? "" : saveFolder)
      case none
        note = ""
  action afterShot
    match shot
      case some(c)
        choose(c.path, c.kind)
        note = copyAfter and (c.kind == "png" or not onLinux) ? "Copied" : "Saved"
        if copyAfter and (c.kind == "png" or not onLinux)
          send copied = copyCapture(c.shown, c.kind)
        if quickAfter
          send shown = showQuick(c.shown, c.kind)
      case none
        note = ""
  action afterRead
    match read
      case some(r)
        note = r.texts.length == 0 ? "No text found" : `Copied ${r.texts.length} ${r.texts.length == 1 ? "line" : "lines"} of text`
        send copied = copyText(r.texts.map(t => t.rawValue).join("\n"))
      case none
        note = ""
  action pressed(id: string)
    if id == "area"
      pickArea()
    if id == "record"
      record()
    if id == "text"
      pickText()
    if id == "screen"
      screen()
    if id == "scroll"
      scrollCapture()
    if id == "window"
      frontWindow()

  // What a floating panel asked for.
  task takeRequest when request.seq > 0 key=request.seq
    change(onRequest)
  action onRequest
    if request.kind == "annotate"
      annotate(request.path)
      focus()
    if request.kind == "stopRecording" and recordingOn
      stop()

  // The library. Choosing a screenshot opens it in the editor, saving unsaved marks on the last one first.
  action choose(path: string, kind: string)
    if dirty and editing != "" and path != editing
      nextPath = path
      nextKind = kind
      save()
    else
      if path != editing
        open(path, kind)
  action open(path: string, kind: string)
    selected = path
    if kind == "png"
      annotate(path)
    else
      editing = ""
  action copy
    if dirty and editing != ""
      copyNext = true
      save()
    else
      match current
        case some(c)
          note = "Copied"
          send copied = copyCapture(c.shown, c.kind)
        case none
          note = ""
  action pin
    match current
      case some(c)
        send acted = pinCapture(c.shown)
      case none
        note = ""
  action reveal
    send acted = revealCapture(selected)
  action remove
    match current
      case some(c)
        send removed = deleteCapture(c.path, c.stem)
        selected = ""
      case none
        note = ""
  action show
    focus()

  // The editor.
  action annotate(path: string)
    editing = path
    selected = path
    dirty = false
    marks = []
    undone = []
    cw = 0
    background = false
    textOn = false
    drawing = false
    send opened = openEdit(path)
  action afterOpened
    match opened
      case some(o)
        if o.path == editing
          marks = o.marks
          background = o.background
          cx = o.cx
          cy = o.cy
          cw = o.cw
          ch = o.ch
      case none
        note = ""
  action useTool(name: string)
    placeText()
    tool = name
  action useColor(value: string)
    color = value
  action useLevel(value: number)
    level = value
  action toggleBackground
    background = not background
    dirty = true
  action down(e: PointerEvent)
    let x = round(e.offsetX * k - pad + vx)
    let y = round(e.offsetY * k - pad + vy)
    if textOn
      placeText()
    else
      if tool == "text"
        textOn = true
        tx = x
        ty = y
        textLeft = e.offsetX
        textTop = e.offsetY
        textValue = ""
        focus("text-entry")
      else
        if tool == "step"
          marks = marks.concat([Mark(kind="step", color=color, size=stroke, x1=x, y1=y, x2=x, y2=y, points="", text="", n=steps + 1)])
          undone = []
          dirty = true
        else
          drawing = true
          sx = x
          sy = y
          ex = x
          ey = y
          pts = `${x},${y}`
  action move(e: PointerEvent)
    if drawing
      let x = round(e.offsetX * k - pad + vx)
      let y = round(e.offsetY * k - pad + vy)
      ex = x
      ey = y
      if tool == "pen" or tool == "marker"
        pts = `${pts} ${x},${y}`
  action up(e: PointerEvent)
    if drawing
      drawing = false
      if tool == "crop"
        if max(ex - sx, sx - ex) > 8 and max(ey - sy, sy - ey) > 8
          cx = max(0, min(sx, ex))
          cy = max(0, min(sy, ey))
          cw = min(iw - max(0, min(sx, ex)), max(ex - sx, sx - ex))
          ch = min(ih - max(0, min(sy, ey)), max(ey - sy, sy - ey))
          tool = "arrow"
          dirty = true
      else
        if tool == "pen" or tool == "marker" or max(ex - sx, sx - ex) + max(ey - sy, sy - ey) > 4
          marks = marks.concat([draft])
          undone = []
          dirty = true
  action typeText(value: string)
    textValue = value
  action placeText
    if textOn
      textOn = false
      if textValue.trim() != ""
        marks = withText
        undone = []
        dirty = true
  action undo
    if marks.length > 0
      undone = undone.concat(marks.slice(marks.length - 1, marks.length))
      marks = marks.slice(0, marks.length - 1)
      dirty = true
  action redo
    if undone.length > 0
      marks = marks.concat(undone.slice(undone.length - 1, undone.length))
      undone = undone.slice(0, undone.length - 1)
      dirty = true
  action resetCrop
    cw = 0
    dirty = true
  action save
    placeText()
    exporting = true
    send saved = saveEdit(editing, withText, background, cx, cy, cw, ch)
  action afterSaved
    match saved
      case some(c)
        exporting = false
        dirty = false
        note = copyAfter or copyNext ? "Saved and copied" : "Saved"
        if copyAfter or copyNext
          send copied = copyCapture(c.shown, c.kind)
        if nextPath != ""
          open(nextPath, nextKind)
        else
          selected = c.path
        copyNext = false
        nextPath = ""
      case none
        exporting = false
        nextPath = ""
        copyNext = false
  // Back to the marks as last saved.
  action revert
    annotate(editing)
  // Single keys pick tools while the editor is open and no text is being typed; Escape drops the text.
  action editKey(key: string, e: KeyboardEvent)
    if key == "Escape"
      textOn = false
    else
      if editing != "" and not textOn and not e.metaKey and not e.ctrlKey and not e.altKey
        if key == "a"
          useTool("arrow")
        if key == "r"
          useTool("rect")
        if key == "o"
          useTool("ellipse")
        if key == "l"
          useTool("line")
        if key == "p"
          useTool("pen")
        if key == "h"
          useTool("marker")
        if key == "t"
          useTool("text")
        if key == "b"
          useTool("pixelate")
        if key == "n"
          useTool("step")
        if key == "s"
          useTool("spotlight")
        if key == "c"
          useTool("crop")

  // Settings.
  action flipCopy(checked: bool)
    copyAfter = checked
  action flipQuick(checked: bool)
    quickAfter = checked
  action flipCursor(checked: bool)
    recCursor = checked
  action flipClicks(checked: bool)
    recClicks = checked
  action flipAudio(checked: bool)
    recAudio = checked
  action flipMic(checked: bool)
    recMic = checked
  action flipLogin(checked: bool)
    if checked
      send loginSet = registerLoginItem(hidden=true)
    else
      send loginSet = unregisterLoginItem()
  action useFormat(value: string)
    recFormat = value

  view
    column globalshortcut=pressed key=editKey width="100%" height="100%" color-scheme="dark" background-color="-exact-background"
      input id="save-folder" display="none" change=chose
      if onMac
        button -exact-menu="status" aria-label="Glint" popovertarget="glint-menu" testId="status"
          image (recordingOn ? "symbol:icon.stop" : busy ? "symbol:icon.busy" : "symbol:icon.capture")
        column id="glint-menu" popover="auto" role="menu" aria-label="Glint"
          if recordingOn
            button press=stop testId="menu-stop"
              text (scrolling ? "Finish Scrolling Capture" : "Stop Recording")
            hr
          button press=screen testId="menu-screen"
            text "Capture Screen"
          button press=pickArea testId="menu-area"
            text "Capture Area"
          button press=pickWindow testId="menu-window"
            text "Capture Window"
          button press=scrollCapture testId="menu-scroll"
            text "Scrolling Capture"
          button press=pickText testId="menu-text"
            text "Capture Text"
          if not recordingOn
            button press=record testId="menu-record"
              text "Record Screen"
          hr
          button press=show testId="menu-open"
            text "Open Glint"
      row gap=8 padding=8 align-items="center" border-bottom="1px solid -exact-separator"
        button press=screen disabled=busy testId="screen"
          text "Screen"
        button press=pickArea disabled=busy testId="area"
          text "Area"
        button press=pickWindow disabled=busy testId="window"
          text "Window"
        button press=scrollCapture disabled=(busy and not scrolling) testId="scroll"
          text (scrolling ? "Done" : "Scroll")
        if not onLinux
          button press=pickText disabled=busy testId="text"
            text "Text"
        button press=record disabled=(busy and not recordingOn) testId="record"
          text (recordingOn and not scrolling ? "Stop" : "Record")
        text (problem != "" ? problem : note != "" ? note : keysLine(screenKey, areaKey, recordKey, textKey, scrollKey, windowKey, onLinux)) flex=1 font-size=11 color=(problem != "" ? "-exact-system-red" : "-exact-secondary-label") testId="status-line"
        button popovertarget="settings" aria-label="Settings" testId="settings-button"
          image "symbol:settings" width=14 height=14
        column id="settings" popover="auto" color-scheme="dark" padding=12 gap=8 testId="settings"
          text "After a capture" font-size=11 color="-exact-secondary-label"
          row gap=6 align-items="center"
            input type="checkbox" checked=copyAfter change=flipCopy aria-label="Copy to the clipboard" testId="set-copy"
            text "Copy to the clipboard" font-size=12
          if onMac
            row gap=6 align-items="center"
              input type="checkbox" checked=quickAfter change=flipQuick aria-label="Show the floating thumbnail" testId="set-quick"
              text "Show the floating thumbnail" font-size=12
          if login.available
            row gap=6 align-items="center"
              input type="checkbox" checked=(login.state == "enabled") change=flipLogin aria-label="Open at login" testId="set-login"
              text "Open at login" font-size=12
          if onLinux
            text "Save to" font-size=11 color="-exact-secondary-label"
            row gap=6 align-items="center"
              text (saveTo == "" ? "No folder yet" : saveTo) flex=1 font-size=12 testId="set-folder-path"
              button press=chooseFolder testId="set-folder"
                text "Choose…"
          text "Recording" font-size=11 color="-exact-secondary-label"
          row gap=6 align-items="center"
            select value=recFormat change=useFormat aria-label="Format" testId="set-format"
              option "MP4" value="mp4"
              option "GIF" value="gif"
          row gap=6 align-items="center"
            input type="checkbox" checked=recCursor change=flipCursor aria-label="Show the cursor" testId="set-cursor"
            text "Show the cursor" font-size=12
          if onMac
            row gap=6 align-items="center"
              input type="checkbox" checked=recClicks change=flipClicks aria-label="Highlight clicks" testId="set-clicks"
              text "Highlight clicks" font-size=12
          row gap=6 align-items="center"
            input type="checkbox" checked=recAudio change=flipAudio aria-label="Record system audio" testId="set-audio"
            text "Record system audio" font-size=12
          row gap=6 align-items="center"
            input type="checkbox" checked=recMic change=flipMic aria-label="Record the microphone" testId="set-mic"
            text "Record the microphone" font-size=12
      row flex=1 min-height=0
        scroll width=230 border-right="1px solid -exact-separator"
          column testId="list"
            if captures.length == 0
              text "No captures yet." padding=8 font-size=12 color="-exact-secondary-label" testId="empty"
            for c in captures key=c.path
              button press=choose(c.path, c.kind) padding=6 gap=8 display="flex" align-items="center" background-color=(c.path == selected ? "-exact-fill" : "transparent") testId=`row-${c.name}`
                if c.kind == "mp4" or (c.kind == "gif" and onLinux)
                  column width=56 height=36 align-items="center" justify-content="center" background-color="-exact-fill"
                    image "symbol:icon.video" width=16 height=16 color="-exact-secondary-label"
                else
                  image c.shown width=56 height=36 object-fit="cover"
                column flex=1 min-width=0 align-items="flex-start"
                  text formatDate(c.taken, 0, "medium") font-size=12
                  text sizeLine(c) font-size=11 color="-exact-secondary-label"
        column flex=1 min-width=0
          match current
            case some(c)
              row gap=8 padding=6 align-items="center" border-bottom="1px solid -exact-separator"
                text c.name flex=1 font-size=12 color="-exact-secondary-label" testId="current"
                if c.kind == "png" or not onLinux
                  button press=copy aria-keyshortcuts="Meta+C" testId="copy"
                    text "Copy"
                if c.kind == "png" and onMac
                  button press=pin testId="pin"
                    text "Pin"
                if onMac
                  button press=reveal testId="reveal"
                    text "Show in Finder"
                button press=remove testId="delete"
                  text "Delete"
              if editing != "" and editing == c.path
                row gap=4 padding=6 align-items="center" border-bottom="1px solid -exact-separator" testId="tools"
                  for t in ["arrow", "rect", "ellipse", "line", "pen", "marker", "text", "pixelate", "step", "spotlight", "crop"] key=t
                    button press=useTool(t) aria-label=toolTip(t) title=toolTip(t) aria-pressed=(tool == t) padding=4 border-radius=5 background-color=(tool == t ? "-exact-fill" : "transparent") testId=`tool-${t}`
                      image (t == "ellipse" ? "symbol:circle" : `symbol:icon.${t}`) width=16 height=16
                  hr height=18 width=1
                  for k in ["#ff3b30", "#ff9500", "#ffcc00", "#34c759", "#0a84ff", "#bf5af2", "#ffffff", "#000000"] key=k
                    button press=useColor(k) aria-label=k aria-pressed=(color == k) width=18 height=18 border-radius=9 background-color=k border=(color == k ? "2px solid -exact-label" : "1px solid -exact-separator") testId=`color-${k}`
                  hr height=18 width=1
                  for n in [1, 2, 3] key=n
                    button press=useLevel(n) aria-label=`size ${n}` aria-pressed=(level == n) padding=4 border-radius=5 background-color=(level == n ? "-exact-fill" : "transparent") testId=`size-${n}`
                      text (n == 1 ? "S" : n == 2 ? "M" : "L") font-size=11
                  hr height=18 width=1
                  button press=toggleBackground aria-pressed=background padding=4 border-radius=5 background-color=(background ? "-exact-fill" : "transparent") testId="background"
                    text "Background" font-size=11
                  if cw > 0
                    button press=resetCrop padding=4 testId="reset-crop"
                      text "Uncrop" font-size=11
                  view flex=1
                  button press=undo aria-keyshortcuts="Meta+Z" aria-label="Undo" title="Undo (⌘Z)" disabled=(marks.length == 0) testId="undo"
                    image "symbol:icon.undo" width=14 height=14
                  button press=redo aria-keyshortcuts="Shift+Meta+Z" aria-label="Redo" title="Redo (⇧⌘Z)" disabled=(undone.length == 0) testId="redo"
                    image "symbol:icon.redo" width=14 height=14
                  if dirty
                    button press=revert testId="revert"
                      text "Revert"
                  button press=save aria-keyshortcuts="Meta+S" title="Save (⌘S)" disabled=(pending(saved) or not dirty) testId="save"
                    text "Save"
                column flex=1 min-height=0 align-items="center" justify-content="center" padding=16 testId="stage"
                  box position="relative" width=cssW height=cssH overflow="hidden"
                    // Saving draws the picture again at its own pixels (CSS size x the display's scale), under this one.
                    if exporting
                      canvas surface=export(editing, mosaic, withText, draft, false, vx, vy, vw, vh, pad, unit) width=(bw / dpr) height=(bh / dpr) position="absolute" left=0 top=0 pointer-events="none" testId="export"
                    canvas surface=annotate(editing, mosaic, marks, draft, drawing, vx, vy, vw, vh, pad, unit) position="relative" width=cssW height=cssH pointerdown=down pointermove=move pointerup=up touch-action="none" cursor="crosshair" testId="ink"
                    if textOn
                      input id="text-entry" value=textValue input=typeText submit=placeText placeholder="Text" position="absolute" left=textLeft top=(textTop - stroke * 2 / k) width=220 font-size=(stroke * 3.5 / k) color=color background-color="transparent" border="1px dashed -exact-separator" testId="text-entry"
              else
                if c.kind != "png" and onLinux
                  text "No preview of a recording on Linux yet." padding=8 color="-exact-secondary-label" testId="no-preview"
                else
                  if c.kind == "mp4"
                    video src=c.path controls=true width="100%" flex=1 min-height=0 testId="player"
                  else
                    image c.shown width="100%" flex=1 min-height=0 object-fit="contain" padding=8 testId="preview"
            case none
              text "Pick a capture." padding=8 color="-exact-secondary-label" testId="hint"
