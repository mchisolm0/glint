 }
+
+/// The page's ground at a point no node paints, and whether it reads dark.
+fn ground(p: &mut Presenter<()>, x: u32, y: u32) -> ([u8; 3], bool) {
+    let px = p.frame().pixel(x, y).unwrap().demultiply();
+    let rgb = [px.red(), px.green(), px.blue()];
+    (rgb, rgb.iter().all(|&c| c < 96))
+}
+
+/// `color-scheme="dark"` on the root, under a light system: the text turns
+/// light, so the ground under it is dark too, as it is once the root paints
+/// `-exact-background`.
+#[test]
+fn a_dark_root_scheme_darkens_the_windows_ground() {
+    let page = |background: &str| {
+        let mut p = source(&format!(
+            "component App\n  view\n    main color-scheme=\"dark\" {background}width=400 height=300\n      text \"Hi\"\n"
+        ));
+        p.set_system_scheme(false);
+        ground(&mut p, 300, 200)
+    };
+    let (painted, dark) = page("background-color=\"-exact-background\" ");
+    assert!(dark, "painting -exact-background: {painted:?}");
+    let (rgb, dark) = page("");
+    assert!(
+        dark,
+        "the ground under a dark root is {rgb:?} (painting -exact-background: {painted:?})"
+    );
+}
