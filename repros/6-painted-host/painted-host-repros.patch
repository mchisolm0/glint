+/// An app that links no module of its own and composes one package: the
+/// painted host fills the native slot's hosted app module for the package's
+/// calls, and exact-js answers `native.available` from that slot
+/// (`js/src/door.rs`), so the app is told it has a module whose every call is
+/// refused.
+#[test]
+fn a_package_handler_does_not_stand_for_the_apps_own_module() {
+    crate::desktop::install(Rc::new(Fake::default()));
+    let plan = crate::test_plan("component App\n  view\n    text \"Hi\"\n");
+    let (mut p, _) = Presenter::boot_with(
+        &plan,
+        Nothing,
+        (400., 800.),
+        1.,
+        std::path::PathBuf::new(),
+        PainterChoice::Cpu,
+    )
+    .unwrap();
+    p.serve_packages(vec![Entry::of::<global_shortcuts::GlobalShortcuts>(
+        "global-shortcuts",
+    )]);
+    // What `native.later({value})` sends: no package's extension.
+    let refused = call(&mut p, json!({"value": "x"}));
+    assert!(
+        !p.host().runner().native_slot().hosted(),
+        "the slot holds a hosted app module, so native.available is true, \
+         and the app's own call answers {refused}"
+    );
+}
