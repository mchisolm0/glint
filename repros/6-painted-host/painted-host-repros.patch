@@ -95,3 +95,38 @@ fn popover_pixels_and_pointer_input_use_the_padded_content_box() {
         Some(&exact_runner::Value::Number(1.))
     );
 }
+
+/// A popover under a dark root, the root's ground painted, the system light:
+/// the popover inherits the root's `color-scheme` and draws dark, with no
+/// `color-scheme="dark"` of its own. `SCHEME` is the popover's own word.
+const DARK_ROOT: &str = r##"component App
+  view
+    main color-scheme="dark" background-color="-exact-background" width="100%" height="100%"
+      button "Open" popovertarget="menu" testId="open" width=80 height=32
+      column id="menu" popover="auto" role="dialog" width=200 height=100 testId="menu" SCHEME
+        text "In"
+"##;
+
+fn popover_surface(scheme: &str) -> [u8; 3] {
+    setup();
+    let mut p = boot(&DARK_ROOT.replace("SCHEME", scheme), 480.);
+    p.set_system_scheme(false);
+    p.tap(id(&p, "open")).unwrap();
+    p.run_commands(|| ());
+    let (x, y, w, h) = p.rect_of(id(&p, "menu")).unwrap();
+    let c = (p.frame().pixel((x + w - 20.) as u32, (y + h / 2.) as u32))
+        .unwrap()
+        .demultiply();
+    [c.red(), c.green(), c.blue()]
+}
+
+#[test]
+fn a_popover_under_a_dark_root_draws_dark() {
+    let said = popover_surface("color-scheme=\"dark\"");
+    assert!(said.iter().all(|&c| c < 96), "saying it is dark: {said:?}");
+    let inherited = popover_surface("");
+    assert!(
+        inherited.iter().all(|&c| c < 96),
+        "inheriting the root's dark scheme: {inherited:?} (saying it: {said:?})"
+    );
+}
diff --git a/js/tests/it/native_later.rs b/js/tests/it/native_later.rs
index 96430eb59..f011d5c2e 100644
--- a/js/tests/it/native_later.rs
+++ b/js/tests/it/native_later.rs
@@ -208,3 +208,36 @@ fn native_calls_receive_the_modules_numbers_exactly() {
         assert_eq!(later, expected, "native.later of {n:e}");
     }
 }
+
+/// The painted host fills the slot's hosted handler for its own packages
+/// (`presenter/requests.rs` `handle_modules`) and refuses any other call
+/// `NotSupportedError`. That handler is not the app's module: an app that
+/// links none is told `native.available` is false, and its source falls back.
+#[test]
+fn a_hosts_package_handler_is_not_the_apps_module() {
+    let root = Root::new();
+    let mut m = root.module();
+    let mut s = Store::new(GRANTS, Vec::<(String, Vec<u8>)>::new());
+    m.native()
+        .expect("a module offers its native handle")
+        .host(Some(std::sync::Arc::new(|_, reply: exact_runner::Reply| {
+            reply.send(exact_runner::Outcome::Response(exact_runner::Response {
+                status: 200,
+                headers: Vec::new(),
+                body: br#"{"error":"NotSupportedError"}"#.to_vec(),
+            }))
+        })));
+    m.activate().unwrap();
+    // `native.call` behind `if (!native?.available)`.
+    let a = args("native", "x");
+    let answer = m.answer(&mut s, "work", &a).unwrap();
+    assert_eq!(finish(&mut m, &mut s, &a, answer), "no native module");
+    // `native.later` behind the same gate.
+    let a = args("later", "x");
+    let answer = m.answer(&mut s, "work", &a).unwrap();
+    assert!(
+        matches!(answer, Answer::Now(_)),
+        "native.available was true, so the call left for the host: {answer:?}"
+    );
+    assert_eq!(finish(&mut m, &mut s, &a, answer), "no native module");
+}
