#!/bin/sh
# Runs a command inside the headless session's environment (the nested Hyprland one with GLINT_E2E_DESKTOP=hyprland), e.g. `run gst-launch-1.0 videotestsrc ! waylandsink`.
here=$(cd -P "$(dirname "$0")/.." && pwd)
. "$here/env.sh"
if [ "${GLINT_E2E_DESKTOP:-}" = hyprland ]; then . "$here/hypr.sh"; fi
exec env -u GLINT_E2E_HARNESS "$@"
